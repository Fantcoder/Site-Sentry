        {
          "ruleId": "dir-listing",
          "level": "warning",
          "message": {
            "text": "Directory listing is enabled\n\nEvidence: Page body matches directory listing pattern: '<title>\\\\s*Index of\\\\s*/'\n\nExplanation: The web server is configured to display a list of files in a directory when no index file is present. This can expose sensitive files, source code, backups, and internal structure to attackers.\n\nFix: Disable directory listing in your web server configuration. Apache: Options -Indexes. nginx: autoindex off. IIS: Disable Directory Browsing in site settings."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "http://127.0.0.1:59205/secret-dir/"
                }
