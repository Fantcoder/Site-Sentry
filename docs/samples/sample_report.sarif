        {
          "ruleId": "tech-disclosure",
          "level": "note",
          "message": {
            "text": "Server header reveals version\n\nEvidence: server: uvicorn, Apache/2.4.49\n\nExplanation: The 'server' header reveals the software product and version (Apache/2.4.49). This helps attackers identify unpatched software and target known CVEs.\n\nFix: Remove or redact the 'server' header. In Apache: ServerTokens Prod. In nginx: server_tokens off. In PHP: expose_php = Off."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "http://127.0.0.1:59205/"
                }
              }
            }
          ],
          "properties": {
            "severity": "low",
            "checkId": "tech-disclosure"
          }
        },
        {
          "ruleId": "tech-disclosure",
          "level": "note",
          "message": {
            "text": "X-Powered-By header reveals version\n\nEvidence: x-powered-by: PHP/7.4.3\n\nExplanation: The 'x-powered-by' header reveals the software product and version (PHP/7.4.3). This helps attackers identify unpatched software and target known CVEs.\n\nFix: Remove or redact the 'x-powered-by' header. In Apache: ServerTokens Prod. In nginx: server_tokens off. In PHP: expose_php = Off."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "http://127.0.0.1:59205/"
                }
              }
            }
