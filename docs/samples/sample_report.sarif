          "message": {
            "text": "backup.zip exposed\n\nEvidence: HTTP 200, size=75 bytes\n\nExplanation: Backup archive is publicly accessible\n\nFix: Remove or restrict access to /backup.zip. Ensure your web server does not serve sensitive files. Add these paths to your .gitignore and review deployment scripts."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "http://127.0.0.1:59205/backup.zip"
