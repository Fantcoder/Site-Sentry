        {
          "ruleId": "exposed-files",
          "level": "none",
          "message": {
            "text": "robots.txt hints\n\nEvidence: HTTP 200, size=32 bytes, body starts with 'User-agent: *\\nDisallow: /admin/\\n'\n\nExplanation: robots.txt is present; review Disallow rules for sensitive paths\n\nFix: Remove or restrict access to /robots.txt. Ensure your web server does not serve sensitive files. Add these paths to your .gitignore and review deployment scripts."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "http://127.0.0.1:59205/robots.txt"
                }
