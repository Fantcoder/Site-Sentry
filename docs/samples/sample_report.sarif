          "message": {
            "text": ".DS_Store file exposed\n\nEvidence: HTTP 200, size=8 bytes\n\nExplanation: macOS .DS_Store file reveals directory structure\n\nFix: Remove or restrict access to /.DS_Store. Ensure your web server does not serve sensitive files. Add these paths to your .gitignore and review deployment scripts."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
